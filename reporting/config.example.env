# Airtable
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
REPORTING_AIRTABLE_VIEW_ID=

# Historical reporting database / outputs
REPORT_DB_PATH=/home/springvolunteer/Airtable2Trello/reporting_data/reporting.db
REPORT_OUTPUT_DIR=/home/springvolunteer/Airtable2Trello/reports

# Optional WhatsApp database (used for aggregate activity counts)
WHATSAPP_DB_PATH=/home/springvolunteer/Airtable2Trello/whatsapp_service.db

# Optional staff filter; blank = include all staff
REPORT_ALLOWED_STAFF=

# These three fields are expected to be added/populated if you want robust outcome/provider reporting.
REPORT_HOUSING_PROVIDER_FIELD=Housing Provider / Organisation
REPORT_HOUSING_OUTCOME_FIELD=Housing Outcome
REPORT_REFERRAL_OUTCOME_FIELD=Referral Outcome
REPORT_OVERALL_OUTCOME_FIELD=Overall Case Outcome

# Keep false for management reports. The reporting layer does not include client names by default.
REPORT_INCLUDE_PII=false
